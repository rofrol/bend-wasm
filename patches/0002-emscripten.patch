 // The machine stack of each thread; -D BEND_STACK_BYTES=... changes it.
+#if !defined(BEND_STACK_BYTES) && defined(__EMSCRIPTEN__)
+#define BEND_STACK_BYTES (1ull << 23)
+#endif
