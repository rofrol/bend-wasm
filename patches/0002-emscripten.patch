+#if defined(__EMSCRIPTEN__)
+// mprotect is a stub and wasm raises no SIGSEGV, so there is no guard page:
+// WL_ROOM stops at stk_end. The 16 KiB past it hold the frame a task's
+// entry pushes (WL_FRAME, WL_ARGS), which WL_ROOM does not check. One
+// worker, so one stack.
+static Term* pool_stack(void) {
+  u64   len = BEND_STACK_BYTES;
+  char* p   = pool_mmap(len + 16384);
+  stk_end   = (Term*)(p + len);
+  return (Term*)p;
+}
